# dsh-pod 环境变量样例 —— 复制为 .env 或按需注入（不要提交真实 key）
# 全部可选：缺省行为已在各模块写死，仅需覆盖时设置

# ── 后端鉴权 ──
# 火山方舟（Ark）agent plan key：无工具执行能力，适合 research/review/问答
# 读取优先级：本环境变量 > ~/.claude/settings.json 的 ARK_API_KEY
ARK_API_KEY=ark-...

# ── 数据目录 ──
# Pod 数据根（默认 ~/.dsh/pod：pod.db / memory / charters / experiments.json）
# 多开/隔离环境用：POD_DATA_DIR 指向独立目录
POD_DATA_DIR=

# ── 后端版本锁定覆盖（Berd-A，显式逃生门）──
# 版本锁定 mismatch 时用（需与锁内 bin 一致的 CLI 路径）
POD_CLAUDE_BIN=claude
POD_CODEX_BIN=codex

# ── MCP Streamable HTTP（远程访问，CR-29）──
# 默认 127.0.0.1:3947，loopback-only；绑非 loopback 必须设 POD_MCP_TOKEN（否则拒绝启动）
POD_MCP_HOST=127.0.0.1
POD_MCP_PORT=3947
POD_MCP_TOKEN=

# ── 外部协作通道 webhook（Berd-H，CR-31）──
# 默认 127.0.0.1:3960；绑非 loopback 必须设 POD_CHANNEL_TOKEN（否则拒绝启动）
POD_CHANNEL_HOST=127.0.0.1
POD_CHANNEL_PORT=3960
POD_CHANNEL_TOKEN=

# ── 多机 satellite（CR-30）──
# 本机连卫星：POD_SATELLITE_URL 必填才启用 remote 后端；POD_SATELLITE_VENDOR=被代理 vendor
POD_SATELLITE_URL=
POD_SATELLITE_VENDOR=claude
POD_SATELLITE_TOKEN=
# 卫星机侧（scripts/satellite-worker.mjs）：后端与端口
POD_SATELLITE_BACKEND=stub
POD_SATELLITE_HOST=127.0.0.1
POD_SATELLITE_PORT=3950

# ── 开发/测试 ──
# 真实 CLI 冒烟（tests/preflight.live.test.ts 可选）
POD_LIVE_PREFLIGHT=0
# 记忆收益写码验收分片（scripts/memory-eval-code.mjs）
ME_START=0
ME_END=4

# ── 宿主 ──
NODE_ENV=development